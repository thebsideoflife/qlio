{
  "name": "qlio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:fingerprint": "npx tsx src/scripts/test-segment-metadata-fingerprint.ts",
    "test:agent-thread": "npx tsx --tsconfig tsconfig.app.json src/scripts/test-agent-thread.ts",
    "test:zoom-math": "npx tsx src/scripts/test-zoom-math.ts",
    "test:export-package": "npx tsx src/lib/exportPackage.test.ts",
    "test:transcript": "npx tsx --tsconfig tsconfig.app.json src/lib/transcript.test.ts",
    "test:caption-grouping": "npx tsx --tsconfig tsconfig.app.json src/remotion/captionGrouping.test.ts",
    "test:caption-content": "npx tsx --tsconfig tsconfig.app.json src/remotion/captionContent.test.ts",
    "test:caption-fonts": "npx tsx --tsconfig tsconfig.app.json src/remotion/loadCaptionFonts.test.ts",
    "test:framing": "npx tsx --tsconfig tsconfig.app.json src/remotion/framingInterpolation.test.ts",
    "test:timeline-keyframes": "npx tsx --tsconfig tsconfig.app.json src/lib/timelineKeyframes.test.ts",
    "test:frame-cuts": "npx tsx --tsconfig tsconfig.app.json src/store/editorFrameCuts.test.ts",
    "test:scene-order": "npx tsx --tsconfig tsconfig.app.json src/store/editorSceneOrder.test.ts",
    "test": "npm run test:fingerprint && npm run test:agent-thread && npm run test:zoom-math && npm run test:export-package && npm run test:transcript && npm run test:caption-content && npm run test:caption-fonts && npm run test:caption-grouping && npm run test:framing && npm run test:timeline-keyframes && npm run test:frame-cuts && npm run test:scene-order",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.10.1",
    "@remotion/cli": "^4.0.386",
    "@remotion/google-fonts": "4.0.387",
    "@remotion/lambda": "^4.0.387",
    "@remotion/player": "^4.0.386",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "mediabunny": "1.25.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.6",
    "remark-breaks": "^4.0.0",
    "remotion": "^4.0.386",
    "tailwind-merge": "^3.4.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.2.1",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  }
}
