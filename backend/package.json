{
  "name": "qlio-backend",
  "version": "1.0.0",
  "description": "Serverless backend for Qlio",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/handlers/*.ts --bundle --platform=node --target=node18 --outdir=dist --external:@remotion/lambda --external:@remotion/renderer",
    "pegasus:eval": "tsx src/scripts/pegasus15-eval.ts",
    "jockey:eval": "tsx src/scripts/jockey-eval.ts",
    "jockey:eval:suite": "tsx src/scripts/jockey-eval-suite/run.ts",
    "jockey:prewarm": "tsx src/scripts/prewarm-jockey-agents.ts",
    "test:export-metadata": "tsx src/scripts/test-export-metadata-fingerprint.ts",
    "test:agent-metadata": "tsx src/scripts/test-agent-metadata.ts",
    "test:jockey-coverage": "tsx src/scripts/test-jockey-coverage.ts",
    "test:jockey-v3-gates": "tsx src/scripts/test-jockey-v3-gates.ts",
    "test:iq-agent": "tsx src/scripts/test-iq-agent.ts",
    "iq-agent:replay": "tsx src/scripts/replay-iq-agent-run.ts",
    "iq-agent:coverage-cost": "tsx src/scripts/check-coverage-cost.ts",
    "test:transcription-sanitize": "tsx src/scripts/test-transcription-sanitize.ts",
    "test": "npm run test:export-metadata && npm run test:agent-metadata && npm run test:jockey-coverage && npm run test:jockey-v3-gates && npm run test:iq-agent && npm run test:transcription-sanitize"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-bedrock-runtime": "^3.947.0",
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-lambda": "^3.400.0",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/client-secrets-manager": "^3.400.0",
    "@aws-sdk/client-sts": "^3.948.0",
    "@aws-sdk/cloudfront-signer": "^3.1048.0",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "@google/generative-ai": "^0.24.1",
    "@remotion/lambda": "^4.0.387",
    "@remotion/renderer": "^4.0.387",
    "axios": "^1.6.0",
    "form-data": "^4.0.5",
    "twelvelabs-js": "^1.2.4",
    "uuid": "^13.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
