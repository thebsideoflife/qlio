# FFmpeg Lambda Container Image
# Uses AWS Lambda Node.js base image with FFmpeg installed
# IMPORTANT: Must be built with --platform linux/amd64 on ARM Macs

FROM --platform=linux/amd64 public.ecr.aws/lambda/nodejs:20

# Install FFmpeg from Amazon Linux extras
RUN dnf install -y \
    tar \
    xz \
    && dnf clean all

# Download and install static FFmpeg build
# Using a static build ensures consistent behavior
RUN curl -L https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz -o /tmp/ffmpeg.tar.xz \
    && tar -xf /tmp/ffmpeg.tar.xz -C /tmp \
    && mv /tmp/ffmpeg-*-amd64-static/ffmpeg /usr/local/bin/ \
    && mv /tmp/ffmpeg-*-amd64-static/ffprobe /usr/local/bin/ \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe \
    && rm -rf /tmp/ffmpeg* \
    && ffmpeg -version

# Copy package files
COPY package*.json ${LAMBDA_TASK_ROOT}/

# Install production dependencies only
WORKDIR ${LAMBDA_TASK_ROOT}
RUN npm ci --omit=dev

# Copy built handlers (stitchSegments for rendering, splitVideo for long video splitting)
COPY dist/stitchSegments.js ${LAMBDA_TASK_ROOT}/
COPY dist/splitVideo.js ${LAMBDA_TASK_ROOT}/

# Default handler (can be overridden in Lambda config)
CMD [ "stitchSegments.handler" ]

